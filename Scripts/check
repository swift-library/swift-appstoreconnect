#!/bin/bash
# SPDX-License-Identifier: Apache-2.0 WITH Swift-exception
# Copyright (c) 2026 Xudong Xu
set -euo pipefail
cd "$(dirname "$0")/.."
case "${1:-all}" in
  all) export RELEASE_CHECK_SCOPE=all ;;
  --format-check) export RELEASE_CHECK_SCOPE=format ;;
  --compiler-check) export RELEASE_CHECK_SCOPE=compiler ;;
  *) echo 'Usage: Scripts/check [--format-check|--compiler-check]' >&2; exit 2 ;;
esac
mkdir -p .build/release-validation
Scripts/validate-version --json > .build/release-validation/version.json
swift package dump-package > .build/release-validation/package.json
python3 - <<'PY'
import json, pathlib
config = json.loads(pathlib.Path('.github/release.json').read_text())
package = json.loads(pathlib.Path('.build/release-validation/package.json').read_text())
platforms = {p['platformName'].lower(): p['version'] for p in package['platforms']}
expected = {name.lower(): str(min(generations)) + '.0' for name, generations in config['platforms'].items()}
if platforms != expected:
    raise SystemExit('Deployment minimum differs from the declared platform policy')
if package['toolsVersion']['_version'] != config['minimum_swift'] + '.0':
    raise SystemExit('Swift tools minimum differs from the declared compiler policy')
PY
Scripts/check-spec
if [ "$RELEASE_CHECK_SCOPE" = all ] || [ "$RELEASE_CHECK_SCOPE" = format ]; then
  xcrun swift-format lint --strict --configuration .swift-format --recursive Package.swift Sources Tests Plugins
fi
if [ "$RELEASE_CHECK_SCOPE" = all ] || [ "$RELEASE_CHECK_SCOPE" = compiler ]; then
  python3 -B -m unittest discover -s Tests/ReleaseTools
  python3 - <<'PY'
import json, pathlib, re, shutil, subprocess
root = pathlib.Path('.build/release-validation')
config = json.loads(pathlib.Path('.github/release.json').read_text())
results = []
for entry in config['trait_configurations']:
    name = entry['name']
    print('Build and test traits: ' + name, flush=True)
    log_path = root / ('tests-' + name + '.log')
    build_path = pathlib.Path('.build/release-traits') / name
    command = ['swift', 'test', '--build-system', 'native', '--scratch-path', str(build_path), '--force-resolved-versions', '--disable-index-store',
               '-debug-info-format', 'none', *entry['arguments']]
    with log_path.open('w') as log:
        status = subprocess.run(command, stdout=log, stderr=subprocess.STDOUT).returncode
    text = log_path.read_text(errors='replace')
    if status:
        print('\n'.join(text.splitlines()[-25:]))
        raise SystemExit('Trait validation failed: ' + name + '; inspect ' + str(log_path))
    matches = re.findall(r'Test run with (\d+) tests.*?passed', text)
    if not matches:
        raise SystemExit('Trait validation did not report a passing test count: ' + name)
    results.append({'name': name, 'arguments': entry['arguments'], 'command': command,
                    'test_count': sum(map(int, matches)), 'exit_status': status})
    shutil.rmtree(build_path)
(root / 'traits.json').write_text(json.dumps(results, indent=2) + '\n')
PY
  swift build --build-system native -c release --product appstoreconnect --force-resolved-versions > .build/release-validation/release-build.log 2>&1
  cli="$(swift build --build-system native -c release --show-bin-path)/appstoreconnect"
  "$cli" --version > .build/release-validation/cli-version.txt
  diff VERSION .build/release-validation/cli-version.txt
  "$cli" --help > .build/release-validation/cli-help.txt
  "$cli" --generate-completion-script zsh > .build/release-validation/completion.zsh
  "$cli" workflow dry-run public-release-readiness --app-id example-app > .build/release-validation/cli-dry-run.txt
  Scripts/check-docs
  Scripts/check-consumer
fi
python3 - <<'PY'
import hashlib, json, os, pathlib, platform, subprocess, tempfile
root = pathlib.Path('.build/release-validation')
prefixes = {str(pathlib.Path.cwd()): '<package>', str(pathlib.Path.home()): '<home>',
            tempfile.gettempdir(): '<temporary>',
            subprocess.check_output(['xcode-select', '-p'], text=True).strip(): '<developer>'}
if tempfile.gettempdir().startswith('/var/'):
    prefixes['/private' + tempfile.gettempdir()] = '<temporary>'
for path in root.iterdir():
    if path.suffix not in ('.log', '.json', '.txt', '.zsh', '.bash', '.fish'):
        continue
    if path.name == 'check.log':
        continue
    log = path.read_text(errors='replace')
    for prefix, replacement in sorted(prefixes.items(), key=lambda item: len(item[0]), reverse=True):
        log = log.replace(prefix, replacement).replace(prefix.replace('/', '\\/'), replacement)
    path.write_text(log)
result = json.loads((root / 'version.json').read_text())
result['scope'] = os.environ['RELEASE_CHECK_SCOPE']
result['os'] = platform.platform()
result['swift'] = subprocess.check_output(['swift', '--version'], text=True).strip()
result['xcode'] = subprocess.check_output(['xcodebuild', '-version'], text=True).strip()
result['sdks'] = {sdk: subprocess.check_output(['xcrun', '--sdk', sdk, '--show-sdk-version'], text=True).strip()
                  for sdk in ('macosx', 'iphonesimulator', 'appletvsimulator', 'watchsimulator', 'xrsimulator')}
result['validation_script_sha256'] = hashlib.sha256(pathlib.Path('Scripts/check').read_bytes()).hexdigest()
result['format_configuration_sha256'] = hashlib.sha256(pathlib.Path('.swift-format').read_bytes()).hexdigest()
result['checks'] = ['version', 'manifest-requirements', 'spec-checksum']
if result['scope'] in ('all', 'format'):
    result['checks'].append('strict-format')
    result['formatter'] = subprocess.check_output(['xcrun', 'swift-format', '--version'], text=True).strip()
if result['scope'] in ('all', 'compiler'):
    result['checks'] += ['release-tools', 'trait-matrix', 'release-build', 'cli-smoke', 'docc', 'local-consumer', 'platform-builds']
    result['traits'] = json.loads((root / 'traits.json').read_text())
    result['documentation'] = json.loads((root / 'documentation.json').read_text())
    result['consumer'] = json.loads((root / 'consumer.json').read_text())
result['checker_digests'] = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in pathlib.Path('Scripts').iterdir() if p.is_file()}
result['evidence_paths'] = 'package, home, temporary and developer directory prefixes normalized in text receipts and logs'
(root / 'provenance.json').write_text(json.dumps(result, indent=2) + '\n')
PY
echo 'checks ok'
