"""Compile and merge every public module's DocC catalog with warnings as errors."""
import argparse
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import sys
import tarfile

MODULES = ['AppStoreConnectCore', 'AppStoreConnectPublicAPI', 'AppStoreConnectWorkflow',
           'AppStoreConnectWebSession', 'AppStoreConnectIrisAPI', 'AppStoreConnectCLI']


def main():
    argparse.ArgumentParser(description=__doc__).parse_args()
    root = Path(__file__).resolve().parent.parent
    evidence = root / '.build/release-validation'
    evidence.mkdir(parents=True, exist_ok=True)
    work = root / '.build/documentation'
    graphs = work / 'symbol-graphs'
    if work.exists():
        shutil.rmtree(work)
    graphs.mkdir(parents=True)
    result = subprocess.run(['swift', 'build', '--build-system', 'native', '--scratch-path', str(work / 'build'),
                             '--traits', 'Experimental,default',
                             '--force-resolved-versions', '--disable-index-store', '-debug-info-format', 'none',
                             '-Xswiftc', '-emit-symbol-graph', '-Xswiftc', '-emit-symbol-graph-dir', '-Xswiftc', str(graphs)], cwd=root,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    (evidence / 'docc-symbolgraph.log').write_text(result.stdout)
    if result.returncode:
        raise RuntimeError('Symbol extraction failed; inspect .build/release-validation/docc-symbolgraph.log')
    archives = []
    graph_digests = {}
    generated_prefix = (root / '.build').as_uri() + '/'
    for module in MODULES:
        symbols = work / (module + '-symbols')
        if symbols.exists():
            shutil.rmtree(symbols)
        symbols.mkdir()
        selected = [graphs / (module + '.symbols.json'), *graphs.glob(module + '@*.symbols.json')]
        for path in selected:
            graph = json.loads(path.read_text())
            for symbol in graph.get('symbols', []):
                if symbol.get('location', {}).get('uri', '').startswith(generated_prefix):
                    del symbol['location']
            output = symbols / path.name
            output.write_text(json.dumps(graph) + '\n')
            graph_digests[path.name] = hashlib.sha256(output.read_bytes()).hexdigest()
        archive = work / (module + '.doccarchive')
        with (evidence / ('docc-' + module + '.log')).open('w') as log:
            subprocess.run(['xcrun', 'docc', 'convert', str(root / 'Sources' / module / (module + '.docc')),
                            '--additional-symbol-graph-dir', str(symbols), '--output-path', str(archive),
                            '--checkout-path', str(root), '--source-service', 'github',
                            '--source-service-base-url', 'https://github.com/swift-library/swift-appstoreconnect/blob/master',
                            '--warnings-as-errors'], cwd=root, stdout=log, stderr=subprocess.STDOUT, check=True)
        archives.append(archive)
    merged = work / 'swift-appstoreconnect.doccarchive'
    with (evidence / 'docc-merge.log').open('w') as log:
        subprocess.run(['xcrun', 'docc', 'merge', *map(str, archives), '--output-path', str(merged),
                        '--synthesized-landing-page-name', 'swift-appstoreconnect'], cwd=root,
                       stdout=log, stderr=subprocess.STDOUT, check=True)
    archive = evidence / 'swift-appstoreconnect.doccarchive.tar.gz'
    with tarfile.open(archive, 'w:gz') as bundle:
        bundle.add(merged, arcname=merged.name)
    receipt = {'checker_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
               'modules': MODULES, 'traits': ['PublicAPIBase', 'Experimental'], 'symbol_graphs': graph_digests,
               'archive': archive.name, 'archive_sha256': hashlib.sha256(archive.read_bytes()).hexdigest(),
               'checks': ['public-symbol-extraction', 'docc-warnings-as-errors', 'docc-merge']}
    (evidence / 'documentation.json').write_text(json.dumps(receipt, indent=2) + '\n')
    shutil.rmtree(work)
    print('DocC compilation and merge passed for ' + str(len(MODULES)) + ' modules')


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print('check-docs: ' + str(error), file=sys.stderr)
        sys.exit(1)
