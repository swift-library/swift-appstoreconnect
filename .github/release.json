{
  "repository": "swift-library/swift-appstoreconnect",
  "version_file": "VERSION",
  "version_pattern": "^([^\\n]+)\\n?$",
  "changelog": "CHANGELOG.md",
  "check_command": "Scripts/check",
  "minimum_swift": "6.3",
  "platforms": {
    "iOS": [
      16,
      26,
      27
    ],
    "macOS": [
      13,
      26,
      27
    ],
    "tvOS": [
      16,
      26,
      27
    ],
    "watchOS": [
      9,
      26,
      27
    ],
    "visionOS": [
      1,
      26,
      27
    ]
  },
  "trait_configurations": [
    {
      "name": "default",
      "arguments": []
    },
    {
      "name": "disabled",
      "arguments": [
        "--disable-default-traits"
      ]
    },
    {
      "name": "full",
      "arguments": [
        "--traits",
        "PublicAPIFull"
      ]
    },
    {
      "name": "experimental",
      "arguments": [
        "--traits",
        "Experimental,default"
      ]
    }
  ],
  "ci": {
    "include": [
      {
        "name": "macos-15-swift-6.3-minimum",
        "runner": "macos-15",
        "xcode": "26.4",
        "command": "Scripts/check --compiler-check"
      },
      {
        "name": "macos-26-swift-6.3",
        "runner": "macos-26",
        "xcode": "26.6",
        "command": "Scripts/check --compiler-check"
      },
      {
        "name": "strict-format",
        "runner": "macos-26",
        "xcode": "26.6",
        "command": "Scripts/check --format-check"
      }
    ]
  }
}
